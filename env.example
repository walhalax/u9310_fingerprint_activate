# Example environment file for u9310_fingerprint_activate.
# Copy to ~/.config/u9310_fingerprint_activate/env and fill in real values.
#
#   cp env.example ~/.config/u9310_fingerprint_activate/env
#   chmod 600 ~/.config/u9310_fingerprint_activate/env

# Tailscale 認証キー (https://login.tailscale.com/admin/settings/keys)
# tskey-auth-xxxxxxxxxxxxxxxx
TS_AUTHKEY=

# Phased-updates を強制無効化する (デフォルト有効)
# SETUP_PHASED=0 で無効化
# SETUP_PHASED=1

# 任意 PPA の追加を無効化する (デフォルト有効)
# SETUP_EXTRA_PPAS=0 で無効化
# SETUP_EXTRA_PPAS=1

# カラー出力を無効化する
# NO_COLOR=1